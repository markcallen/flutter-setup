# Use Ubuntu 24.04 to get Python 3.12+
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

# Install all prerequisites defined in prerequisites_linux.py
RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-venv python3-full sudo git curl xz-utils unzip \
    libglu1-mesa clang cmake ninja-build pkg-config libgtk-3-dev \
    libayatana-appindicator3-dev liblzma-dev openjdk-17-jdk \
    && rm -rf /var/lib/apt/lists/*

# Install a pinned uv binary.
COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /uvx /usr/local/bin/

# Setup user
RUN useradd -m -s /bin/bash developer && \
    echo "developer ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

WORKDIR /app
RUN chown developer:developer /app

USER developer

# Pre-install Flutter SDK
RUN mkdir -p ~/development && \
    git clone https://github.com/flutter/flutter.git -b stable ~/development/flutter

ENV PATH="/home/developer/development/flutter/bin:/home/developer/.local/bin:$PATH"

# Run flutter doctor to pre-download artifacts
RUN flutter doctor
